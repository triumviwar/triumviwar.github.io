 "talks": {
  "fairleigh_old": {"name": "FIELD MARSHAL FAIRLEIGH", "colour": 4, "portrait": "res://campaign/portraits/fairleigh.png", "entries": [
   {"after": "a06_barricades", "lines": ["Paris, Your Majesty. Three barricades, one street, and the King's patience.", "I am old now. I still hear the canister."]},
   {"after": "a06_barricades", "flag": {"a06_barricades.varenne": "executed"}, "lines": ["Varenne went to the scaffold. The Assembly made a saint of him by morning."]},
   {"after": "a07_council", "lines": ["Rome burned one night, and held. I was not there. The young King was."]}]},
  "ruggieri": {"name": "GENERAL RUGGIERI", "colour": 4, "portrait": "res://campaign/portraits/ruggieri.png", "entries": [
   {"after": "p01_leaf", "lines": ["The guns, Highness. In Virginia they were two. In Rome there are more.", "Earn the King's favour in the field, and I will spend it here on what the men need."]},
   {"after": "a06_barricades", "lines": ["Paris wanted the Mortar. My old crew will come with you again, if you call them."]}]},
  "delorme": {"name": "CAPTAIN DELORME", "colour": 4, "entries": [
   {"after": "a01_presses", "lines": ["Lyon is quiet. Two of my riders are yours whenever you want them."]},
   {"after": "a01_presses", "flag": {"a01_presses.lyon": "sullen"}, "lines": ["Lyon is sullen, not quiet. Still, two of my riders are yours."]}]},
  "swiss": {"name": "THE SWISS CAPTAIN", "colour": 4, "entries": [
   {"after": "a07_council", "lines": ["The bridges held till dawn. My pikes go where the King sends them."]}]},
  "votive": {"name": "THE VOTIVE CANDLES", "colour": 4, "entries": [
   {"after": "p01_leaf", "lines": ["A candle burns for the dead of the tobacco country."]},
   {"after": "p01_leaf", "flag": {"p01_leaf.families": "save"}, "lines": ["A candle burns for the dead of the tobacco country, and one of thanks from the Hollins families."]}]},
  "notre_dame": {"name": "A STONE FROM NOTRE-DAME", "colour": 4, "entries": [
   {"after": "a06_barricades", "lines": ["A carved stone from the cathedral's porch, kept here so Paris is prayed for."]}]},
  "assembly_flag": {"name": "THE ASSEMBLY'S FLAG", "colour": 4, "entries": [
   {"after": "", "lines": ["Green and black, taken at the fort gate in Virginia. Scorched at one edge."]}]},
  "type_case": {"name": "ROUVIÈRE'S TYPE CASE", "colour": 4, "entries": [
   {"after": "a01_presses", "lines": ["The printer's letters, taken at Lyon. He set the pamphlets with them. He named Paris."]}]},
  "bastille_key": {"name": "THE BASTILLE'S KEY", "colour": 4, "entries": [
   {"after": "a06_barricades", "lines": ["The key of the old fortress's magazine. The Assembly wanted its powder; the King's army took it first."]}]},
  "varenne_letter": {"name": "VARENNE'S LETTER", "colour": 4, "entries": [
   {"after": "a06_barricades", "lines": ["A letter from exile, unsigned. The hand is Varenne's. He thanks no one."]}]},
  "sentence": {"name": "THE SENTENCE", "colour": 4, "entries": [
   {"after": "a06_barricades", "lines": ["The sentence on Etienne Varenne, signed and sealed. Father Tomasz asked for mercy. It was not given."]}]},
  "council_decree": {"name": "THE COUNCIL'S DECREE", "colour": 4, "entries": [
   {"after": "a07_council", "lines": ["The Council of Rome: no machine may govern itself, and the specimens are to be destroyed."]},
   {"after": "a07_council", "flag": {"a07_council.hollweg": "defied"}, "lines": ["The Council of Rome: no machine may govern itself, and the specimens are to be destroyed. Two men walked out on it."]}]},
  "jakob": {"name": "JAKOB", "colour": 5, "entries": [
   {"after": "c01_thirteenth", "lines": ["I kept the drawings, Meister. Every part of it. We can do better with honest work.", "Bring back what you find in the field, and I will draw you a better soldier."]},
   {"after": "a02_furth", "lines": ["The Honest One stops when it is told. That is all I wanted."]},
   {"after": "a04_visit", "lines": ["Father Ferrer asks about every gear. I answer. It is better that way."]}]},
  "ferrer": {"name": "FATHER FERRER", "colour": 4, "entries": [
   {"after": "a04_visit", "lines": ["I came to see the guild's work. I stay because someone must."]},
   {"after": "a04_visit", "flag": {"a04_visit.broken": "kept"}, "lines": ["You kept the broken ones. I pray you never need to explain why."]},
   {"after": "a04_visit", "flag": {"a04_visit.broken": "melted"}, "lines": ["The broken ones are brass again. That was right."]}]},
  "ulrich": {"name": "MASTER ULRICH", "colour": 5, "entries": [
   {"after": "c01_thirteenth", "lines": ["Forty years a Winder. My lads will wind your soldiers in the field, if you want them.", "Guild marks pay for parts. Earn them, and the bench is yours."]}]},
  "rauch": {"name": "COLONEL VON RAUCH", "colour": 4, "entries": [
   {"after": "a02_furth", "lines": ["The line held. My musketeers will march with the Father when he visits you, and I will drill them first."]}]},
  "anselm": {"name": "BROTHER ANSELM", "colour": 4, "entries": [
   {"after": "a04_visit", "lines": ["Every machine in this yard is written in my book. Every one."]}]},
  "honest_one": {"name": "THE HONEST ONE", "colour": 5, "entries": [
   {"after": "a02_furth", "lines": ["The guild's first machine with a stop-work. It stands still when it is told to."]}]},
  "broken_kept": {"name": "THE BROKEN ONES", "colour": 5, "entries": [
   {"after": "a04_visit", "lines": ["Under the tarpaulin, the machines that went wrong. Hollweg kept them to learn."]}]},
  "broken_melted": {"name": "THE MELTED BRASS", "colour": 5, "entries": [
   {"after": "a04_visit", "lines": ["An ingot of brass. It was a dozen machines once."]}]},
  "pieter": {"name": "PIETER", "colour": 2, "entries": [
   {"after": "b01_specimen", "lines": ["I got out on the last canoe. The Doctor's notes came with me.", "Field notes buy kit for the next expedition. The store room has it."]},
   {"after": "a05_specimens", "lines": ["We brought the cages down the mountain. I count them every morning."]}]},
  "benedito": {"name": "BENEDITO", "colour": 2, "entries": [
   {"after": "a03_plateau", "lines": ["The river took us down. The river takes everybody down, senhor."]}]},
  "valadares": {"name": "DUARTE VALADARES", "colour": 2, "portrait": "res://campaign/portraits/valadares.png", "entries": [
   {"after": "a03_plateau", "lines": ["The plateau is drawn. Every path up it, for the Crown.", "Learn the map, and choose how the next party marches."]},
   {"after": "a05_specimens", "lines": ["The animals are caged. I did not draw the map for this."]}]},
  "cages": {"name": "THE CAGES", "colour": 2, "entries": [
   {"after": "a05_specimens", "lines": ["Iron cages under the lamps. The animals in them are fed at dusk."]},
   {"after": "a05_specimens", "flag": {"a05_specimens.cages": "all"}, "lines": ["Every cage came down the mountain full. The straw moves at night."]},
   {"after": "a05_specimens", "flag": {"a05_specimens.cages": "few"}, "lines": ["Most cages are empty. The few that came down are watched day and night."]}]},
  "jars": {"name": "THE JARS", "colour": 2, "entries": [
   {"after": "b01_specimen", "lines": ["What came out of the station in jars: eggshell, scales, a tooth."]}]},
  "lisbon_crate": {"name": "THE LISBON CRATE", "colour": 2, "entries": [
   {"after": "a05_specimens", "lines": ["A crate from the quay, stamped LISBON. Inside, a gear. Nobody here made it."]}]}
 }
}
